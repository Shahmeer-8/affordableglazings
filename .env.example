# Quote / enquiry email delivery (src/routes/api.quote.ts)
#
# Without these two set, the form shows the visitor a "please call us"
# message and logs the enquiry to the server console — it does not
# silently pretend to have sent.

# 1. Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# 2. Must be on a domain verified in Resend (Domains → Add Domain, then add
#    the DNS records to affordableglazing.co.uk). A plain gmail/outlook
#    address will be rejected by the API.
QUOTE_FROM_EMAIL="Affordable Glazings <quotes@affordableglazing.co.uk>"

# 3. Optional — where enquiries land. Defaults to sales@affordableglazing.co.uk
# QUOTE_TO_EMAIL=sales@affordableglazing.co.uk
