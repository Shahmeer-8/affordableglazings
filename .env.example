# Quote / enquiry email delivery (src/routes/api.quote.ts)
#
# Never commit real values. Set these in Vercel → Settings → Environment
# Variables with "Production" ticked, then REDEPLOY — an existing deployment
# keeps the environment it was built with, so adding a variable changes
# nothing until the site is rebuilt.
#
# Check whether it worked by opening https://<your-site>/api/quote in a
# browser. It reports which transport is active without echoing any secret.

# ─── Option 1: SMTP through the company's own IONOS mailbox (in use) ────────
# Nothing to sign up for and no DNS to verify — the mailbox already exists.
SMTP_USER=sales@affordableglazing.co.uk
SMTP_PASS=
# Optional. Defaults shown; affordableglazing.co.uk's MX is IONOS.
# SMTP_HOST=smtp.ionos.co.uk
# SMTP_PORT=587          # 587 = STARTTLS (default), 465 = implicit TLS

# ─── Option 2: Resend HTTP API (only if SMTP is not set) ────────────────────
# Better deliverability at volume. Requires a verified domain in Resend.
# RESEND_API_KEY=
# QUOTE_FROM_EMAIL="Affordable Glazings <quotes@affordableglazing.co.uk>"

# ─── Both options ──────────────────────────────────────────────────────────
# Where enquiries land. Defaults to sales@affordableglazing.co.uk
# QUOTE_TO_EMAIL=sales@affordableglazing.co.uk
